rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && get(/databases/$(database)/documents/config/access).data.adminUid == request.auth.uid;
    }
    match /publicSummary/{id} { allow read: if true; }
    match /publicOperations/{id} { allow read: if true; }
    match /publicExpenses/{id} { allow read: if true; }
    match /publicEvents/{id} { allow read: if true; }
    match /publicControls/{id} { allow read: if true; }
    match /users/{uid} { allow read: if signedIn() && request.auth.uid == uid; }
    match /members/{id} { allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid); }
    match /operations/{id} { allow read: if admin(); }
    match /events/{id} { allow read: if admin(); }
    match /controls/{id} { allow read: if admin(); }
    match /calls/{id} { allow read: if admin(); }
    match /audit/{id} { allow read: if admin(); }
    match /config/{id} { allow read: if admin(); }
    // Every mutation is validated by the callable backend using the Admin SDK.
    match /{document=**} { allow read, write: if false; }
  }
}
