{
  "name": "comptes-bar-gap-tooling",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "emulators": "firebase emulators:start --project demo-comptes-bar-gap --only auth,firestore,functions,storage --import=.emulator-data --export-on-exit=.emulator-data",
    "bootstrap:local": "node scripts/bootstrap.mjs --emulator",
    "test:server": "npm --prefix functions test",
    "test:emulators": "firebase emulators:exec --project demo-comptes-bar-gap --only auth,firestore,functions,storage \"npm --prefix functions run test:rules && npm --prefix functions run test:integration\"",
    "test:browser": "npm --prefix functions run test:integration && node scripts/smoke-web.mjs",
    "migration:prepare": "node scripts/prepare-migration-2026.mjs --live-read-only",
    "migration:simulate": "node scripts/prepare-migration-2026.mjs --fixture",
    "migration:apply": "node scripts/apply-migration-2026.mjs --apply excel_2026_v1"
  },
  "devDependencies": {
    "firebase-tools": "15.31.0",
    "playwright": "1.63.0"
  }
}
