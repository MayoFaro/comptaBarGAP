rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      return request.auth != null && firestore.get(/databases/(default)/documents/config/access).data.adminUid == request.auth.uid;
    }
    match /receipts/{operationId}/{fileName} {
      allow read, delete: if admin();
      allow create, update: if admin() && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
    }
  }
}
